# syntax=docker/dockerfile:1
# Dashboard image — Next.js static export + Nginx reverse proxy for /api.
# Build context: repo root (gold-signal-bot/)
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json next.config.mjs postcss.config.mjs tsconfig.json ./
RUN npm ci --no-audit --no-fund
COPY src ./src
RUN npm run build:static

FROM nginx:1.27-alpine AS runtime
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/out /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O - http://127.0.0.1/healthz >/dev/null || exit 1
