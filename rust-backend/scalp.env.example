# Scalp service environment (copy to rust-backend/.env.scalp on the server; mode 0600).
# Never commit the real token/chat ID.
PORT=8091
BOT_PROFILE=scalp
RUST_LOG=info
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AI_PROVIDER=NONE
YAHOO_FUTURES_VOLUME_ENABLED=true
# Compose sets EXNESS_BARS_PATH=/exness-data/exness_bars.json
# and mounts the shared host data dir read-only at /exness-data.
