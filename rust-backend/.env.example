# ============================================================
# Gold Signal Bot — Rust Backend Environment (100% FREE APIs)
# Copy this file to `.env` and fill in only what you need.
# ============================================================

# --- Telegram Bot (FREE forever via @BotFather) ---
# Token obtained from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Chat ID via @userinfobot or public channel username, e.g. @YourSignalChannel
TELEGRAM_CHAT_ID="-1001234567890"

# --- Market Data ---
# Default: leave empty to use Binance Public API (PAXGUSDT), no API key required.
# Optional: free TwelveData key (800 req/day) to use spot XAU/USD instead.
TWELVEDATA_API_KEY=""

# Optional: allow additional browser origins (comma-separated). Same-origin dashboard needs none.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://xauusd-bot.tailec308e.ts.net"

# --- Optional TradingView Webhook protection ---
# If set, TradingView alerts must include the same "passphrase" field.
WEBHOOK_PASSPHRASE=""

# --- Optional AI Macro Report ---
# AI is OPTIONAL and only used for the daily 07:00 macro commentary.
# Core signals always use the free EMA50/200 heuristic; no key = EMA fallback.
# AI_PROVIDER: "GEMINI", "OPENROUTER", or "NONE" (case-insensitive).
# "" = auto-detect (Gemini key first, then OpenRouter).
AI_PROVIDER=""
# Gemini (recommended, uses the OpenAI-compatible endpoint).
GEMINI_API_KEY=""
# Any current Gemini model can be used; change if you prefer another.
GEMINI_MODEL="gemini-2.5-flash"
# OpenRouter (optional alternative provider).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# --- Axum HTTP Server ---
PORT=8080
RUST_LOG=info

# --- Dashboard-managed config (NOT environment variables) ---
# entry_mode (MARKET / LIMIT_RETEST / BREAKOUT), broker_price_offset,
# max_entry_drift_points, max_candle_age_secs, session_alerts_enabled and
# session_alert_lead_minutes are saved in data/bot_state.json via /api/config.

# Persistent state path is fixed at: data/bot_state.json
