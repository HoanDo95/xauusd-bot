# ============================================================
# Gold Signal Bot — Rust Backend Environment (100% FREE APIs)
# Copy this file to `.env` and fill in only what you need.
# ============================================================

# --- Telegram Bot (FREE forever via @BotFather) ---
# Token obtained from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Chat ID via @userinfobot or public channel username, e.g. @YourSignalChannel
TELEGRAM_CHAT_ID="-1001234567890"

# --- Market Data ---
# OHLCV + volume ALWAYS comes from Binance Public API (PAXGUSDT), no key required.
# Optional: free TwelveData key is used ONLY for the XAU/USD spot price reference
# that auto-calibrates the PAXG premium/discount (cached 300s ≈ 288 calls/day).
# If the key is missing or the call fails, spot falls back to https://api.gold-api.com/price/XAU.
TWELVEDATA_API_KEY="your_twelvedata_api_key_here"

# Optional: allow additional browser origins (comma-separated). Same-origin dashboard needs none.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://xauusd-bot.tailec308e.ts.net"

# --- Optional TradingView Webhook protection ---
# If set, TradingView alerts must include the same "passphrase" field.
WEBHOOK_PASSPHRASE=""

# --- Optional AI Macro Report ---
# AI is OPTIONAL and only used for the daily 07:00 macro commentary (1 call/day).
# Core signals always use the free EMA50/200 heuristic; no key = EMA fallback.
# AI_PROVIDER: "NONE" | "GEMINI" | "OPENROUTER" | "OPENCODE_GO" (case-insensitive).
# "" = auto-detect (OpenCode Go key first, then Gemini, then OpenRouter).
AI_PROVIDER=""
# OpenCode Go (recommended): OpenAI-compatible endpoint, default Gemini 4 Argon.
# The key is read from env/.env only — never commit it or paste it in logs.
OPENCODE_GO_API_KEY=""
OPENCODE_GO_BASE_URL="https://opencode.ai/inference/go/openai/v1"
OPENCODE_GO_MODEL="gemini-4-argon"
# Alternatives for OPENCODE_GO_MODEL:
#   "deepseek-v4.1-flash" (cheap/reasoning), "glm-5.3-flash" (fast/cheap).
# Optional AI Chief Risk Officer (veto-only) for real signals. Model override:
AI_SIGNAL_REVIEW_MODEL="gemini-4-argon"
# AI_SIGNAL_REVIEW_ENABLED is DASHBOARD CONFIG (data/bot_state.json), not env.
# Default OFF; OPENCODE_GO_API_KEY is required only when the dashboard toggle is on.
# Review is veto-only, fail-open by default, one call per real signal (max 1/day).
# Gemini (optional alternative, uses the OpenAI-compatible endpoint).
GEMINI_API_KEY=""
# Any current Gemini model can be used; change if you prefer another.
GEMINI_MODEL="gemini-2.5-flash"
# OpenRouter (optional alternative provider).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# --- Axum HTTP Server ---
PORT=8080
RUST_LOG=info

# --- Dashboard-managed config (NOT environment variables) ---
# entry_mode (MARKET / LIMIT_RETEST / BREAKOUT), broker_price_offset,
# max_entry_drift_points, max_candle_age_secs, session_alerts_enabled,
# session_alert_lead_minutes, ai_signal_review_enabled,
# ai_signal_review_min_confidence and ai_signal_review_fail_open are saved in
# data/bot_state.json via /api/config.

# Persistent state path is fixed at: data/bot_state.json
