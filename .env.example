# Gold Signal Bot — 100% free data feeds. No paid AI key required.

# Optional: override the Rust Axum backend origin used by Next.js rewrites.
# The production dashboard is served same-origin through Nginx /api proxy.
RUST_BACKEND_URL="http://127.0.0.1:8090"

# Optional: Free TwelveData key for the XAU/USD SPOT reference (800 req/day).
# OHLCV + volume always comes from Binance PAXG/USDT (no key required).
# The key only powers auto PAXG→spot basis calibration (cached 300s ≈ 288 calls/day);
# if missing/failing, spot falls back to https://api.gold-api.com/price/XAU.
TWELVEDATA_API_KEY="your_twelvedata_api_key_here"

# Telegram alert channel (free via @BotFather).
# SECURITY: never commit the real bot token; keep it only in .env.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional: Telegram chat ID allowed to use /start, /stop, /view, /status.
TELEGRAM_ADMIN_CHAT_ID=""

# Optional browser CORS origins (comma-separated). Same-origin dashboard needs none.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://xauusd-bot.tailec308e.ts.net"

# Optional TradingView webhook passphrase (also configurable in the dashboard).
# SECURITY: use a long random value (16+ chars, 32+ recommended); never commit it.
WEBHOOK_PASSPHRASE=""

# --- Optional AI Macro Report (Rust backend only) ---
# AI is optional and only used for the daily 07:00 report (1 call/day).
# Core signals always use the free EMA50/200 heuristic.
# AI_PROVIDER: "NONE" | "GEMINI" | "OPENROUTER" | "OPENCODE_GO" (case-insensitive).
# "" = auto-detect (OpenCode Go key first, then Gemini, then OpenRouter); "NONE" = disable AI.
AI_PROVIDER=""
# OpenCode Go (recommended): OpenAI-compatible endpoint, default Gemini 4 Argon.
# Keep the key in env/.env only — never commit it.
OPENCODE_GO_API_KEY=""
OPENCODE_GO_BASE_URL="https://opencode.ai/inference/go/openai/v1"
OPENCODE_GO_MODEL="gemini-4-argon"
# Alternatives for OPENCODE_GO_MODEL:
#   "deepseek-v4.1-flash" (cheap/reasoning), "glm-5.3-flash" (fast/cheap).
# Optional AI Chief Risk Officer (veto-only) for real signals. Model override:
AI_SIGNAL_REVIEW_MODEL="gemini-4-argon"
# AI_SIGNAL_REVIEW_ENABLED is DASHBOARD CONFIG (data/bot_state.json), not env.
# Default OFF; OPENCODE_GO_API_KEY is required only when the dashboard toggle is on.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Entry mode, broker offset, drift/stale guards, session pre-alerts and the
# AI Risk Officer toggles (ai_signal_review_enabled, min confidence, fail-open)
# are dashboard config persisted in data/bot_state.json — do NOT put them here.
# Example: entry_mode=MARKET|LIMIT_RETEST|BREAKOUT, broker_price_offset, etc.

# Legacy Express fallback dashboard port (default 3000).
PORT="3000"
