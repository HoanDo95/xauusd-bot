# Gold Signal Bot — 100% free data feeds. No paid AI key required.

# Optional: override the Rust Axum backend origin used by Next.js rewrites.
# The production dashboard is served same-origin through Nginx /api proxy.
RUST_BACKEND_URL="http://127.0.0.1:8090"

# Optional: Free TwelveData key for XAU/USD spot candles (800 req/day).
# Leave empty to use Binance PAXG/USDT public API (no key required).
TWELVEDATA_API_KEY=""

# Telegram alert channel (free via @BotFather).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional browser CORS origins (comma-separated). Same-origin dashboard needs none.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://xauusd-bot.tailec308e.ts.net"

# Optional TradingView webhook passphrase (also configurable in the dashboard).
WEBHOOK_PASSPHRASE=""

# --- Optional AI Macro Report (Rust backend only) ---
# AI is optional; core signals always use the free EMA50/200 heuristic.
# AI_PROVIDER: "GEMINI", "OPENROUTER", or "NONE" (case-insensitive).
# "" = auto-detect (Gemini key first, then OpenRouter); "NONE" = disable AI.
AI_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Entry mode, broker offset, drift/stale guards and session pre-alerts are
# dashboard config persisted in data/bot_state.json — do NOT put them here.
# Example: entry_mode=MARKET|LIMIT_RETEST|BREAKOUT, broker_price_offset, etc.

# Express / Vite dashboard port (default 3000).
PORT="3000"
